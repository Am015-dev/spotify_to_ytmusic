      "act": 1,
      "title": "Dress for the Fight",
      "boss": false,
      "intro": [
        {
          "who": "hobb",
          "text": "Your strength is your level plus everything you wear. Items win fights."
        },
        {
          "who": "hobb",
          "text": "Equip a helmet, armor, boots and weapons from your treasure cards before you kick."
        },
        {
          "who": "tansy",
          "text": "I just trip over treasure. You'll have to actually wear yours!"
        }
      ],
      "outro": [
        {
          "who": "tansy",
          "text": "All that shiny gear! No wonder the monsters ran."
        },
        {
          "who": "hobb",
          "text": "Good. Now let's talk about when NOT to fight."
        }
      ],
