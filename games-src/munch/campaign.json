          "who": "hobb",
          "text": "Grub helps anyone for a treasure. Ask him for help when a fight looks too big."
        },
        {
          "who": "hobb",
          "text": "And if you can't win, run! Roll 5 or 6 and you get away."
        }
      ],
      "outro": [
        {
          "who": "grub",
          "text": "Hmph. Fine fighting. My axe is for hire whenever you're buying."
        },
        {
          "who": "hobb",
          "text": "The cellar is yours. The Long Corridor waits below."
        }
