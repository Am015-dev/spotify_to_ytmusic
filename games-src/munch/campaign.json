    {
      "act": 1,
      "title": "The Cellar Doors",
      "blurb": "Learn to kick, fight and run in the shallow cellars under Crookhill."
    },
    {
      "act": 2,
      "title": "The Long Corridor",
      "blurb": "Four heroes, sharper rivals: curses, deals and back-stabs."
    },
    {
      "act": 3,
      "title": "The Vault of the Golden Boot",
      "blurb": "The cleverest heroes in the dungeon, and every trick they own."
    }
  ],
  "twists": [
    {
      "id": "boss-head-start",
      "where": "setup",
      "how": "After newGame deals the opening hands, set the boss seat's lvl to 1 + param (never above 9) before the setup phase begins."
    },
    {
      "id": "boss-extra-treasure",
      "where": "setup",
      "how": "After newGame deals the opening hands, call drawTo(P(bossSeat),'treasure',param) so the boss starts with param extra treasure cards."
    },
    {
      "id": "boss-first",
      "where": "setup",
      "how": "After the opening roll in newGame, set G.active, G.first and G.setupOrd so the boss seat takes the first turn."
    },
    {
      "id": "light-pack",
      "where": "setup",
      "how": "After newGame deals the opening hands, discard param random treasure cards from the human seat's hand (into G.td) so you start with fewer treasures."
    }
  ],
  "chapters": [
    {
      "id": "c1",
      "act": 1,
      "title": "The First Door",
      "boss": false,
      "intro": [
        {
          "who": "hobb",
          "text": "Welcome to the Delve, rookie. Every year the doors open and heroes race to level 10."
        },
        {
          "who": "hobb",
          "text": "Kick a door. If a monster jumps out, fight it. Win and you go up a level."
        },
        {
          "who": "pip",
          "text": "Hi! I'm Pip. I'm new too. Let's kick doors together!"
        }
      ],
      "outro": [
        {
          "who": "hobb",
          "text": "Ten levels, and the last from a kill. You've got the knack."
        },
        {
          "who": "hobb",
          "text": "Next, I'll show you how to wear what you find."
        }
      ],
      "opponent": {
        "name": "Pip",
        "portrait": "camp-pip.webp",
        "emoji": "🐿️",
        "cast": "pip",
        "personality": "Cheerful, first through every door, rarely first out. Plays gently.",
        "aiLevel": "easy",
        "aiStyle": "plucky"
      },
      "setup": {
        "mode": "F",
        "n": 3,
        "lvl": "easy",
        "lvmix": [
          "easy",
