function quickMove(S, seat, ctx) {
  const mv = FA.validMoves(S, seat).filter(m => m.t === 'place' || m.t === 'toss' || m.t === 'rrpick' || m.t === 'wt2' || m.t === 'ready');
  if (!mv.length) return null;
