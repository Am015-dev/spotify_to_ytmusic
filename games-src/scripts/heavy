#!/bin/bash
# Run a heavy test (Playwright, gauntlet, p2p) with at most $HEAVY_SLOTS of them machine-wide.
# The box has 4 cores; more than ~3 heavy jobs at once makes every job slower and timeouts look like bugs.
#   games-src/scripts/heavy node lay-phone.js 390x763
SLOTS=${HEAVY_SLOTS:-3}; DIR=/tmp/gns-heavy; mkdir -p "$DIR"
while :; do
  for i in $(seq 1 "$SLOTS"); do
    exec 9>"$DIR/slot$i"
    if flock -n 9; then "$@"; rc=$?; flock -u 9; exit $rc; fi
  done
  sleep 3
done
