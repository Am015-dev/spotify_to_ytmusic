    {
      "id": "boss-rubies",
      "where": "setup",
      "how": "After CF.newGame, add param rubies to the boss seat (G.players[1].rubies += param)."
    },
    {
      "id": "boss-chip",
      "where": "setup",
      "how": "After CF.newGame, call CF._.give(G, G.players[1], param, true) to put one chip of key param (e.g. \"G2\") from the supply into the boss bag at a random spot."
    },
    {
      "id": "boss-droplet",
      "where": "setup",
      "how": "After CF.newGame, set G.players[1].droplet = param so every brew of the boss starts param spaces further on (CF.startPos reads it)."
    },
    {
      "id": "boss-lead",
      "where": "setup",
      "how": "After CF.newGame, set G.players[1].vp = param; from day 2 the normal rat-tail rule gives trailing players their head start."
    },
    {
      "id": "crowded-bag",
      "where": "setup",
      "how": "After CF.newGame, call CF._.give(G, G.players[0], \"W1\", true) param times so the player bag starts with param extra Fizzpod 1 chips."
    }
  ],
