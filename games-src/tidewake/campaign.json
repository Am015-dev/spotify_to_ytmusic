      "act": 1,
      "title": "Lantern Lit",
      "boss": false,
      "intro": [
        {
          "who": "osk",
          "text": "Your first junk, child. Hang the lantern and lay a current in front of your bow."
        },
        {
          "who": "osk",
          "text": "Your ship follows the line to its end. Never let that line run off the board."
        },
        {
          "who": "wick",
          "text": "Race you round the shallows! No sea monsters today, promise."
        }
      ],
      "outro": [
        {
          "who": "osk",
          "text": "You read the water well. Wick ran off the edge, not you."
        },
        {
          "who": "wick",
          "text": "Next time I am watching my own lines!"
        }
