  "acts": [
    {
      "act": 1,
      "title": "Calm Shallows",
      "blurb": "Learn to lay currents, keep off the edge and dodge your first leviathans."
    },
    {
      "act": 2,
      "title": "Open Water",
      "blurb": "Deck Cannons, Rift Gates and the long night watch. The captains stop going easy."
    },
    {
      "act": 3,
      "title": "The Deep Reach",
      "blurb": "Rogue Waves, the Maelstrom and the Admiral who rules the haunted archipelago."
    }
  ],
  "twists": [
    {
      "id": "boss-first",
      "where": "setup",
      "how": "Pass newGame option first = the boss seat (1), so the boss picks its start mark first and takes the first turn."
    },
    {
      "id": "boss-cannon",
      "where": "setup",
      "how": "After newGame has dealt the hands (exp.cannon must be 1), move param Deck Cannons (max 2) from G.deck into the boss hand, sending the same number of its currents to the bottom of G.deck."
    },
    {
      "id": "deep-stir",
      "where": "setup",
      "how": "In newGame, schedule setupMon with n = min(10, LEV_AT_START[np] + param), so param extra leviathans rise at set-up."
    },
    {
      "id": "wave-early",
      "where": "setup",
      "how": "With exp.wave = 1, move WAVE_ID to the front of G.mdeck in newGame before setupMon runs, so the Rogue Wave rises during set-up."
    },
    {
      "id": "harrier",
      "where": "ai",
      "how": "When the boss seat decides, call decide() with a copy of AILV.hard whose push = param (e.g. 30), so evalPos rewards leaving rival junks next to the edge."
    }
  ],
