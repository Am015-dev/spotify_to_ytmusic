{
  "allow_commands": [
    "node",
    "npx playwright",
    "npm test",
    "npm run",
    "python3",
    "python",
    "grep",
    "find",
    "sed -n",
    "awk",
    "sort",
    "diff",
    "md5sum",
    "jq"
  ],
  "limits": {
    "max_cost_usd": 20,
    "max_turns": 200,
    "max_minutes": 60,
    "max_parallel": 5
  }
}